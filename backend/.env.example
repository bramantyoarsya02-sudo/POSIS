APP_NAME="POSIS SMKN 1 Ciomas"
APP_ENV=local
APP_KEY=base64:fH7+9Fm4B93e4Z782qP21mK8s0yU92l0V30vW11aM7I=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Lokal (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=posis_ciomas
DB_USERNAME=root
DB_PASSWORD=

# Atau Database Supabase (PostgreSQL)
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_DATABASE_PASSWORD
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="posis@smkn1ciomas.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi Domain Google Workspace Siswa
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
GOOGLE_RESTRICTED_DOMAIN="siswa.smkn1ciomas.sch.id"

# Aturan Bisnis POSIS
POSIS_SLA_DAYS=7
POSIS_MAX_DAILY_POSTS=5
POSIS_ANONYMOUS_VISIBLE_TO_ADMIN=true

FRONTEND_URL="http://localhost:5173"
SANCTUM_STATEFUL_DOMAINS="localhost:5173,127.0.0.1:5173"
